# syntax=docker/dockerfile:1.7
# A training image for Cosmos3-Nano: NVIDIA's training code at the commit the serving image reads, and the
# released Cosmos3-Nano-Policy-DROID converted to a DCP checkpoint, so a fine-tune starts from the DROID policy and
# keeps its action heads. A VM runs it through train-resume.service (docker/README.md § Training images).
#
# Usage (from the repository root)
#   docker buildx build --platform linux/amd64 --provenance=false --sbom=false \
#       -f docker/Dockerfile.train-cosmos3 -t <registry>/train-cosmos3:<tag> --push .
#
# The build needs no credential: no repository it reads is gated. It downloads 36 GB of weights and converts them on
# the CPU, which needs about 100 GB of memory.
# Licences: OpenMDW-1.1 for the code and the policy, Apache-2.0 for the Wan2.2 VAE (positronic/vendors/cosmos3/NOTICE.training).

ARG POLICY_REPO=nvidia/Cosmos3-Nano-Policy-DROID
ARG POLICY_REVISION=805c0d6d46196ecdc789213a6de72303c383895b
ARG VAE_REPO=Wan-AI/Wan2.2-TI2V-5B
ARG VAE_REVISION=921dbaf3f1674a56f47e83fb80a34bac8a8f203e
ARG COSMOS_FRAMEWORK_REV=12c8a7832fb378e0e2cf7f6b7ebe7a82b729764b

FROM python:3.12-slim@sha256:05cda9777409a9c3ffddd94a4c476b79f0769a0b4857f0c7ed9226b6800b0d6f AS hub
ENV HF_HOME=/opt/hf
RUN pip install --no-cache-dir huggingface_hub==0.35.3

FROM hub AS policy
ARG POLICY_REPO POLICY_REVISION
RUN python -c "from huggingface_hub import snapshot_download as d; d('$POLICY_REPO', revision='$POLICY_REVISION', ignore_patterns=['assets/*', 'images/*'])"

FROM hub AS vae
ARG VAE_REPO VAE_REVISION
RUN python -c "from huggingface_hub import snapshot_download as d; d('$VAE_REPO', revision='$VAE_REVISION', local_dir='/opt/vae', allow_patterns=['Wan2.2_VAE.pth', 'README.md'])"

# The model card, which the conversion below does not keep.
FROM policy AS model-card
ARG POLICY_REPO POLICY_REVISION
RUN mkdir -p /opt/card \
 && cp -L "/opt/hf/hub/models--$(echo "$POLICY_REPO" | sed 's|/|--|g')/snapshots/$POLICY_REVISION/README.md" /opt/card/README.md

FROM nvidia/cuda:13.0.2-cudnn-devel-ubuntu24.04 AS env
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ffmpeg git git-lfs wget \
 && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.12.2 /uv /uvx /usr/local/bin/

ARG COSMOS_FRAMEWORK_REV
WORKDIR /workspace
RUN git clone https://github.com/NVIDIA/cosmos-framework.git . \
 && git checkout "$COSMOS_FRAMEWORK_REV" \
 && rm -rf .git
# The lock pins torch 2.13.0+cu130.
RUN uv sync --locked --all-extras --group=cu130-torch213-train \
 && uv cache clean
ENV PATH="/workspace/.venv/bin:$PATH" \
    TRITON_PTXAS_PATH=/usr/local/cuda/bin/ptxas \
    PYTHONUNBUFFERED=1
# FOOTGUN: without IMAGINAIRE_HF_CLI_ENVIRONMENT, each checkpoint lookup builds a fresh `hf` environment from PyPI.
ENV IMAGINAIRE_HF_CLI_ENVIRONMENT=/opt/hf-cli
RUN UV_PROJECT_ENVIRONMENT=$IMAGINAIRE_HF_CLI_ENVIRONMENT \
      uv sync --project cosmos_framework/utils/hf_cli --locked --no-default-groups \
 && uv cache clean

# The conversion runs on the CPU. Its files go into 8 directories, one layer each, so that no layer holds the whole
# checkpoint. FOOTGUN: a registry can refuse a layer of 30 GB.
FROM env AS dcp
ARG POLICY_REPO POLICY_REVISION
COPY --from=policy /opt/hf/hub /opt/hf/hub
RUN snapshot="/opt/hf/hub/models--$(echo "$POLICY_REPO" | sed 's|/|--|g')/snapshots/$POLICY_REVISION" \
 && python -m cosmos_framework.scripts.convert_model_to_dcp --checkpoint-path "$snapshot" -o /opt/dcp \
 && i=0 && cd /opt/dcp \
 && for f in $(find . -type f | sort); do \
      mkdir -p "/opt/parts/$((i % 8))/$(dirname "$f")" && mv "$f" "/opt/parts/$((i % 8))/$f" && i=$((i + 1)); \
    done

FROM env
RUN mkdir -p /opt/cosmos3 \
 && cp /workspace/LICENSE /opt/cosmos3/LICENSE-OpenMDW-1.1 \
 && curl -fsSL https://www.apache.org/licenses/LICENSE-2.0.txt -o /opt/cosmos3/LICENSE-Apache-2.0
# The run's own environment: it reads and writes the final marker (/opt/train/marker.py).
RUN uv venv --python 3.12 /opt/train/venv \
 && uv pip install --python /opt/train/venv/bin/python boto3==1.35.99 \
 && uv cache clean
COPY --link --from=dcp /opt/parts/0/ /opt/cosmos3/dcp/
COPY --link --from=dcp /opt/parts/1/ /opt/cosmos3/dcp/
COPY --link --from=dcp /opt/parts/2/ /opt/cosmos3/dcp/
COPY --link --from=dcp /opt/parts/3/ /opt/cosmos3/dcp/
COPY --link --from=dcp /opt/parts/4/ /opt/cosmos3/dcp/
COPY --link --from=dcp /opt/parts/5/ /opt/cosmos3/dcp/
COPY --link --from=dcp /opt/parts/6/ /opt/cosmos3/dcp/
COPY --link --from=dcp /opt/parts/7/ /opt/cosmos3/dcp/
COPY --link --from=vae /opt/vae/Wan2.2_VAE.pth /opt/vae/README.md /opt/cosmos3/wan22_vae/
COPY --link --from=model-card /opt/card/README.md /opt/cosmos3/policy-model-card/README.md
COPY --link positronic/vendors/cosmos3/NOTICE.training /opt/cosmos3/NOTICE
COPY --link LICENSE /opt/train/LICENSE
COPY --link docker/train-resume/train-resume.service /opt/train/train-resume.service
COPY --link docker/train-resume/resume.sh /opt/train/resume
COPY --link docker/train-resume/marker.py /opt/train/marker.py
COPY --link docker/train-resume/launch-cosmos3.sh /opt/train/launch
COPY --link positronic/vendors/droid_finetune /opt/train/python/droid_finetune

# The run's TOML reads both through `${oc.env:...}`, as the upstream recipe does.
ENV BASE_CHECKPOINT_PATH=/opt/cosmos3/dcp \
    WAN_VAE_PATH=/opt/cosmos3/wan22_vae/Wan2.2_VAE.pth \
    PYTHONPATH=/opt/train/python
WORKDIR /workspace

LABEL org.opencontainers.image.title="train-cosmos3" \
    org.opencontainers.image.description="Cosmos3-Nano training code and Cosmos3-Nano-Policy-DROID as a DCP checkpoint. OpenMDW-1.1 and Apache-2.0: see /opt/cosmos3/NOTICE." \
    org.opencontainers.image.licenses="LicenseRef-OpenMDW-1.1 AND Apache-2.0" \
    org.opencontainers.image.source="https://github.com/Positronic-Robotics/positronic"
