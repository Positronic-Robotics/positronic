# syntax=docker/dockerfile:1.7
ARG BASE_IMAGE=positro/dreamzero-base:latest
FROM ${BASE_IMAGE}

ENV PYTHONPATH=/opt/positronic-vendors:/dreamzero \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_HTTP_TIMEOUT=600

COPY pyproject.toml uv.lock /opt/positronic-packages/
COPY client/pyproject.toml /opt/positronic-packages/client/
COPY wire/pyproject.toml /opt/positronic-packages/wire/
COPY model_server/pyproject.toml /opt/positronic-packages/model_server/
COPY vocabulary/pyproject.toml /opt/positronic-packages/vocabulary/
COPY evals/pyproject.toml /opt/positronic-packages/evals/
COPY docker/install-model-server-deps.sh /opt/positronic-packages/install-model-server-deps.sh
RUN --mount=type=cache,target=/root/.cache/uv \
    bash /opt/positronic-packages/install-model-server-deps.sh /.venv/bin/python

COPY --link wire /opt/positronic-packages/wire
COPY --link model_server /opt/positronic-packages/model_server
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /.venv/bin/python --no-deps \
      /opt/positronic-packages/wire /opt/positronic-packages/model_server
COPY --link positronic/vendors/dreamzero/serving /opt/positronic-vendors/dreamzero_serving

WORKDIR /opt/positronic-vendors
EXPOSE 8000
STOPSIGNAL SIGINT
ENTRYPOINT ["/.venv/bin/python", "-m", "dreamzero_serving.server"]
CMD ["droid"]
