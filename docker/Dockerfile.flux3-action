# syntax=docker/dockerfile:1.7
# A policy image the platform can run: FLUX 3 Action DROID with Black Forest Labs' serving code, its encoders
# and every weight in the image. It serves positronic's session protocol on port 8000 behind the run's bearer
# token, with no arguments and no network. docs/submit-a-policy-image.md § FLUX 3 Action says what it serves.
#
# Usage
#   make -C docker build-flux3-action                                  # positro/flux3-action:local
#   docker buildx build --platform linux/amd64 --provenance=false --sbom=false \
#       -f docker/Dockerfile.flux3-action -t docker.io/<you>/flux3-action:v1 --push .
#   docker run --rm --network none -e AUTH_TOKEN='two words' positro/flux3-action:local   # refused at once
#
# The build context is the repository root. It needs no credential: no repository it reads is gated. It
# downloads 25 GB of weights, and the image is about 36 GB on disk.
#
# The weights are under the FLUX Kommunity License v1.0, which allows non-commercial use only. The image
# carries the licence and the notice it requires (positronic/vendors/flux3_action/NOTICE).

FROM python:3.12-slim-bookworm

# git clones BFL's code. The compiler is for Triton and Inductor, which build their helpers at the first
# compiled request. positronic's environment installs the GUI build of OpenCV, which loads libxcb, libGL
# and GLib when it is imported.
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential ca-certificates git libgl1 libglib2.0-0 libxcb1 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /usr/local/bin/uv
# positronic's environment has a uv of its own: uv 0.8 cannot read positronic's lock.
COPY --from=ghcr.io/astral-sh/uv:0.11.31 /uv /usr/local/bin/uv-positronic

# BFL's code, Apache-2.0. The lock pins torch 2.10.0+cu128.
ARG FLUX_ACTION_REV=e2dd1d8dbc5977b54315d61f7548c63c043d6d4f
WORKDIR /opt/flux-action
RUN git clone https://github.com/black-forest-labs/flux-action.git . \
 && git checkout "$FLUX_ACTION_REV" \
 && uv sync --locked --no-dev --python 3.12 --extra encoders --extra serve
# The video VAE imports NATTEN at load. Its wheel is built per torch and CUDA, so the lock carries none;
# this suffix matches the torch above.
RUN uv pip install --python .venv/bin/python 'natten==0.21.6+torch2100cu128' -f https://whl.natten.org/

# The policy package the server loads. Offline, a load by `main` finds no ref, so it names the commit.
ENV HF_HOME=/opt/hf-home \
    FLUX_POLICY_REPO=black-forest-labs/flux-3-action-droid \
    FLUX_POLICY_REVISION=3d0887bdc7acee1686b19afac267125d519ff4f1 \
    FLUX_POLICY_SUBFOLDER=variants/gd
# The commit of FLUX 3 Action Base that the policy's config names for its encoders.
ARG FLUX_BASE_REPO=black-forest-labs/flux-3-action-base
ARG FLUX_BASE_REVISION=62878e2925e59b7a89ec14463ce89932624c490d

# One large file per layer. FOOTGUN: a registry can refuse a layer of 30 GB, and the DiT is one 13.9 GB file
# that cannot be split. `variants/gd` is the guidance-distilled BF16 package.
RUN uv run --no-sync python -c "from huggingface_hub import snapshot_download as d; d('$FLUX_POLICY_REPO', revision='$FLUX_POLICY_REVISION', allow_patterns=['$FLUX_POLICY_SUBFOLDER/model.safetensors'])"
RUN uv run --no-sync python -c "from huggingface_hub import snapshot_download as d; d('$FLUX_POLICY_REPO', revision='$FLUX_POLICY_REVISION', allow_patterns=['$FLUX_POLICY_SUBFOLDER/*.json', 'LICENSE.md'])"
# For a policy package of your own, `COPY` its directory in place of the two layers above. In the `ENTRYPOINT`,
# name that directory as `--model.checkpoint` and pass `--model.revision=None --model.subfolder=None`: BFL's loader
# refuses a revision for a directory.
RUN uv run --no-sync python -c "from huggingface_hub import snapshot_download as d; d('$FLUX_BASE_REPO', revision='$FLUX_BASE_REVISION', allow_patterns=['video_vae.safetensors'])"
RUN uv run --no-sync python -c "from huggingface_hub import snapshot_download as d; d('$FLUX_BASE_REPO', revision='$FLUX_BASE_REVISION', allow_patterns=['text_encoder/model-00001-of-00002.safetensors'])"
RUN uv run --no-sync python -c "from huggingface_hub import snapshot_download as d; d('$FLUX_BASE_REPO', revision='$FLUX_BASE_REVISION', allow_patterns=['text_encoder/model-00002-of-00002.safetensors'])"
RUN uv run --no-sync python -c "from huggingface_hub import snapshot_download as d; d('$FLUX_BASE_REPO', revision='$FLUX_BASE_REVISION', allow_patterns=['text_encoder/*.json', 'text_encoder/*.txt', 'text_encoder/README.md'])"

# Every path the server loads, resolved offline, so a file the image misses fails the build and not a
# container on a GPU. The text encoder's processor is the part that asks the Hub for more than its own files.
RUN HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 uv run --no-sync python -c "\
import json; \
from flux_action.config import PolicyConfig; \
from flux_action.hub import resolve_policy_directory; \
from flux_action.models.runtime import parse_weight_spec, resolve_weights; \
from transformers import AutoConfig, AutoProcessor; \
package = resolve_policy_directory('$FLUX_POLICY_REPO', revision='$FLUX_POLICY_REVISION', subfolder='$FLUX_POLICY_SUBFOLDER'); \
config = PolicyConfig(**json.loads((package / 'config.native.json').read_text())); \
print(resolve_weights(config.video_vae_id, 'video_vae.safetensors')); \
repo, folder, revision = parse_weight_spec(config.text_encoder_id); \
AutoConfig.from_pretrained(repo, subfolder=folder, revision=revision); \
AutoProcessor.from_pretrained(repo, subfolder=folder, revision=revision); \
print(package, 'resolves offline')"

# A start that would resolve the Hub ends at model load, not on weights other than the ones this image holds.
ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    PYTHONUNBUFFERED=1

# The licence beside the notice, where a recipient of the image finds both.
COPY positronic/vendors/flux3_action/NOTICE /opt/flux3_action/
RUN cp -L "$HF_HOME/hub/models--black-forest-labs--flux-3-action-droid/snapshots/$FLUX_POLICY_REVISION/LICENSE.md" \
      /opt/flux3_action/LICENSE.md

# positronic's server runs in an environment of its own, beside BFL's. The dependencies install from the lock
# alone, so a source change does not reinstall them.
WORKDIR /positronic
COPY pyproject.toml uv.lock ./
COPY client/pyproject.toml client/
COPY wire/pyproject.toml wire/
COPY model_server/pyproject.toml model_server/
COPY vocabulary/pyproject.toml vocabulary/
RUN uv-positronic sync --locked --python 3.12 --no-dev --no-install-workspace && uv-positronic cache clean
COPY . /positronic
RUN uv-positronic sync --locked --python 3.12 --no-dev && uv-positronic cache clean

# Each interpreter imports what it runs, so a module the image misses fails the build and not a container.
RUN /positronic/.venv/bin/python -c "import positronic.vendors.flux3_action.server" \
 && /opt/flux-action/.venv/bin/python -P /positronic/positronic/vendors/flux3_action/backend.py --help > /dev/null

EXPOSE 8000

# `exec` makes the server pid 1, so it receives the stop signal. The server starts BFL's interpreter itself.
ENTRYPOINT ["/bin/sh", "-c", \
  "exec /positronic/.venv/bin/python -m positronic.vendors.flux3_action.server droid \
   --model.flux_python=/opt/flux-action/.venv/bin/python --model.checkpoint=\"$FLUX_POLICY_REPO\" \
   --model.revision=\"$FLUX_POLICY_REVISION\" --model.subfolder=\"$FLUX_POLICY_SUBFOLDER\" \"$@\"", "--"]

LABEL org.opencontainers.image.title="flux3-action" \
    org.opencontainers.image.description="FLUX 3 Action DROID (guidance-distilled BF16), its video VAE and text encoder, served over positronic's session protocol behind AUTH_TOKEN. FLUX Kommunity License v1.0, non-commercial use only: see /opt/flux3_action/NOTICE." \
    org.opencontainers.image.licenses="LicenseRef-FLUX-Kommunity-1.0 AND Apache-2.0" \
    org.opencontainers.image.source="https://github.com/Positronic-Robotics/positronic"
