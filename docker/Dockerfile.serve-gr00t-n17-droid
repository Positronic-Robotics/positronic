# syntax=docker/dockerfile:1.7
# A policy image the platform can run: GR00T N1.7 DROID on top of `positro/gr00t-base`.
# docs/submit-a-policy-image.md says what the platform requires of the image and how to test it.
#
# Usage (from the repository root)
#   HF_TOKEN=<a read token> make -C docker build-serve-gr00t-n17-droid        # positro/gr00t-n17-droid:local
#   docker buildx build --platform linux/amd64 --secret id=hf_token,src=$HOME/.hf_token --provenance=false --sbom=false \
#       -f docker/Dockerfile.serve-gr00t-n17-droid -t docker.io/<you>/gr00t-n17-droid:v1 --push .
#   docker run --rm --network none --gpus all docker.io/<you>/gr00t-n17-droid:v1        # the offline pre-flight
#
# Source and weights use `COPY --link`; source edits reuse the dependency and weight layers.
#
# The Hugging Face token is for `nvidia/Cosmos-Reason2-2B`, the backbone every N1.7 checkpoint
# loads: the repository is gated, and NVIDIA grants access on the form. The token enters no layer.

ARG BASE_IMAGE=positro/gr00t-base:latest
ARG MODEL=nvidia/GR00T-N1.7-DROID
ARG MODEL_REVISION=05e7cc97e40dbd33b0890c35cc0214fcb0547ab5
ARG BACKBONE=nvidia/Cosmos-Reason2-2B
ARG BACKBONE_REVISION=9ce19a195e423419c349abfc86fd07178b230561

# The weights stage does not build on the base, so a new base reuses the downloaded weights. Its own base is
# pinned by digest: a moved tag would download the weights again and push them as a new layer.
FROM python:3.12-slim@sha256:05cda9777409a9c3ffddd94a4c476b79f0769a0b4857f0c7ed9226b6800b0d6f AS weights
ARG MODEL MODEL_REVISION BACKBONE BACKBONE_REVISION
ENV HF_HOME=/opt/hf
RUN pip install --no-cache-dir huggingface_hub==0.35.3
# A download by commit writes no `refs/main`, and the offline load of the default revision reads it.
RUN --mount=type=secret,id=hf_token \
    export HF_TOKEN="$(cat /run/secrets/hf_token)" \
 && for spec in "${MODEL}@${MODEL_REVISION}" "${BACKBONE}@${BACKBONE_REVISION}"; do \
      repo="${spec%@*}" rev="${spec#*@}" \
   && hf download "$repo" --revision "$rev" > /dev/null \
   && refs="$HF_HOME/hub/models--$(echo "$repo" | sed 's|/|--|g')/refs" \
   && mkdir -p "$refs" && printf %s "$rev" > "$refs/main" || exit 1; \
    done

FROM ${BASE_IMAGE} AS runtime
ARG MODEL

# The server loads GROOT_MODEL_SOURCE, so the model this build caches is the model the image serves.
ENV HF_HOME=/opt/hf \
    GROOT_MODEL_SOURCE=hf://${MODEL} \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/positronic-vendors \
    VIRTUAL_ENV=/opt/gr00t-venv \
    UV_LINK_MODE=copy \
    UV_HTTP_TIMEOUT=600

COPY pyproject.toml uv.lock /opt/positronic-packages/
COPY client/pyproject.toml /opt/positronic-packages/client/
COPY wire/pyproject.toml /opt/positronic-packages/wire/
COPY model_server/pyproject.toml /opt/positronic-packages/model_server/
COPY vocabulary/pyproject.toml /opt/positronic-packages/vocabulary/
COPY docker/install-gr00t-server-deps.sh /opt/positronic-packages/install-gr00t-server-deps.sh
RUN --mount=type=cache,target=/root/.cache/uv bash /opt/positronic-packages/install-gr00t-server-deps.sh

COPY --link wire /opt/positronic-packages/wire
COPY --link model_server /opt/positronic-packages/model_server
RUN --mount=type=cache,target=/root/.cache/uv \
    UV_OFFLINE=0 uv pip install --python /opt/gr00t-venv/bin/python --no-deps \
      /opt/positronic-packages/wire /opt/positronic-packages/model_server \
 && uv pip check --python /opt/gr00t-venv/bin/python

WORKDIR /opt/positronic-vendors
COPY --link positronic/vendors/gr00t/serving /opt/positronic-vendors/gr00t_serving

# GROOT_PATCH_MISTRAL: transformers asks the Hub about the backbone's tokenizer on every load, with
# no cache fallback, and the patch answers that question locally. Without it the offline load fails;
# without HF_HUB_OFFLINE each file costs a retried HEAD request and the load exceeds the ready budget.
ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    UV_OFFLINE=1 \
    UV_NO_SYNC=1 \
    GROOT_PATCH_MISTRAL=1

EXPOSE 8000
STOPSIGNAL SIGINT

ENTRYPOINT ["/opt/gr00t-venv/bin/python", "-m", "gr00t_serving.server", "droid"]

FROM runtime
# For a fine-tuned checkpoint, copy its directory and set GROOT_MODEL_SOURCE to that path.
COPY --link --from=weights /opt/hf /opt/hf
# The NVIDIA Open Model License requires each copy of the models to carry the agreement and this notice.
COPY --link positronic/vendors/gr00t/NOTICE positronic/vendors/gr00t/LICENSE-NVIDIA-Open-Model-License.txt /opt/gr00t/
