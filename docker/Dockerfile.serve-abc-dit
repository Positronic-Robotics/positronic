# syntax=docker/dockerfile:1.7
# A policy image the platform can run: ABC-DiT, the multi-task DiT-XL checkpoint `abc_dit_xl_200k_model.pt` of the
# ABC project, served over positronic's session protocol on port 8000 with no arguments and no network.
# positronic/vendors/abc_dit/README.md says what it serves.
#
# Usage (from the repository root)
#   make -C docker build-serve-abc-dit                                     # <registry>/abc-dit-yam:local
#   make -C docker push-serve-abc-dit                                      # to the private Nebius registry
#   docker run --rm --network none --gpus all <registry>/abc-dit-yam:local # the offline pre-flight
#
# The layers go from the least often changed to the most: base with ABC's environment, positronic's dependencies,
# source, weights, start settings. The source and the weights come in through `COPY --link`, and only the start
# settings come after them, so a source change builds one new layer and pulls no cached layer.
#
# The image holds two Python environments. positronic's server answers on port 8000. It starts ABC's policy server
# in ABC's environment, on 127.0.0.1:9000 inside the container, and sends it each observation. The checkpoint is
# 8.1 GB. The weights are under the Apache License 2.0, and their vision backbone is under the DINOv3 License: the
# image carries both licences and the notice in /opt/abc_dit (positronic/vendors/abc_dit/NOTICE).

# ABC's code at the commit whose server fields and layout the adapter follows. ABC ships no lock, so the resolve
# takes no package newer than that commit.
ARG ABC_REV=6c467cebcecf16a4dce79e6fd87a7ca2281c3ef0
ARG ABC_EXCLUDE_NEWER=2026-09-19T00:00:00Z
ARG ABC_DATA=https://abc-data.timehorizons.org
ARG CHECKPOINT=abc_dit_xl_200k_model
ARG CHECKPOINT_SHA256=79754ece8d333789a930d1a964ee0d4548f5975e2ba175ddce41d018c9f51ba7

# The weights stage does not build on the base, so a new base reuses the downloaded weights. Its own base is pinned
# by digest: a moved tag would download the weights again and push them as a new layer. The data mirror refuses
# Python's default agent, so the fetch sends the agent of ABC's prepare.py.
FROM python:3.12-slim@sha256:05cda9777409a9c3ffddd94a4c476b79f0769a0b4857f0c7ed9226b6800b0d6f AS weights
ARG ABC_DATA CHECKPOINT CHECKPOINT_SHA256
COPY --chmod=755 docker/fetch_abc_checkpoint.py /usr/local/bin/
RUN fetch_abc_checkpoint.py "$ABC_DATA/checkpoints/$CHECKPOINT" "$CHECKPOINT_SHA256" /opt/abc-cache

FROM ghcr.io/astral-sh/uv:python3.12-bookworm
ARG ABC_REV ABC_EXCLUDE_NEWER

# The compiler is for Triton and Inductor, which build their helpers at the first compiled request; the base
# carries it. positronic's environment installs the GUI build of OpenCV, which loads libGL when it is imported.
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 && rm -rf /var/lib/apt/lists/*

# ABC reads its CLIP cache under the home directory, which every user that runs the image can read.
ENV HOME=/opt/abc-home \
    PYTHONUNBUFFERED=1 \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_HTTP_TIMEOUT=600

# ABC's environment: its base dependencies with torch 2.11 for CUDA 12.8, which has `sm_120` kernels, and the
# three packages its policy server imports beyond them. The server fetches the CLIP text encoder at start, so the
# build fetches it into the cache the server reads.
WORKDIR /opt/abc
RUN git clone https://github.com/amazon-far/abc.git . \
 && git checkout "$ABC_REV" \
 && uv sync --no-dev --python 3.12 --exclude-newer "$ABC_EXCLUDE_NEWER" \
 && uv pip install --python .venv/bin/python --exclude-newer "$ABC_EXCLUDE_NEWER" \
      websockets opencv-python-headless msgpack \
 && uv cache clean \
 && mkdir -p /opt/abc_dit "$HOME" && cp LICENSE /opt/abc_dit/LICENSE-ABC \
 && .venv/bin/python -c "from abc_minimal.config import ClipConfig; from abc_minimal.dit import ensure_clip_text_assets; \
      ensure_clip_text_assets(ClipConfig())" \
 && chmod -R a+rX "$HOME"

ENV PYTHONPATH=/positronic:/positronic/client:/positronic/wire:/positronic/model_server:/positronic/vocabulary:/positronic/evals \
    UV_PROJECT_ENVIRONMENT=/positronic/.venv \
    VIRTUAL_ENV=/positronic/.venv

# positronic's server runs in an environment of its own, beside ABC's. The dependencies install from the lock
# alone, so a source change does not reinstall them.
WORKDIR /positronic
COPY pyproject.toml uv.lock ./
COPY client/pyproject.toml client/
COPY wire/pyproject.toml wire/
COPY model_server/pyproject.toml model_server/
COPY vocabulary/pyproject.toml vocabulary/
COPY evals/pyproject.toml evals/
RUN uv sync --locked --python 3.12 --no-dev --no-install-workspace && uv cache clean

# The workspace installs from its manifests and package stubs, which records each package's metadata.
# The source then lands with no step after it: the packages import from PYTHONPATH.
COPY README.md LICENSE ./
COPY client/README.md client/
COPY wire/README.md wire/
COPY model_server/README.md model_server/
COPY vocabulary/README.md vocabulary/
COPY evals/README.md evals/
COPY positronic/__init__.py positronic/
COPY pimm/__init__.py pimm/
COPY client/platform_client/py.typed client/platform_client/
COPY wire/positronic_wire/py.typed wire/positronic_wire/
COPY model_server/positronic_model_server/py.typed model_server/positronic_model_server/
COPY vocabulary/eval_vocabulary/py.typed vocabulary/eval_vocabulary/
COPY evals/positronic_evals/py.typed evals/positronic_evals/
RUN uv sync --locked --python 3.12 --no-dev && uv cache clean

COPY --link . /positronic

# For a checkpoint of your own, `COPY` it in place of the `weights` layer and name it in ABC_DIT_CHECKPOINT.
COPY --link --from=weights /opt/abc-cache /opt/abc-cache
# The licences beside the notice, where a recipient of the image finds them.
COPY --link positronic/vendors/abc_dit/NOTICE positronic/vendors/abc_dit/LICENSE-DINOv3.md /opt/abc_dit/

# A fetch the build did not make fails at once on the denied network.
ENV UV_OFFLINE=1 \
    UV_NO_SYNC=1

ARG CHECKPOINT
ENV ABC_DIT_CHECKPOINT=/opt/abc-cache/${CHECKPOINT}.pt

EXPOSE 8000

# `exec` makes the server pid 1, so it receives the stop signal. The server starts ABC's interpreter itself.
ENTRYPOINT ["/bin/sh", "-c", \
  "exec /positronic/.venv/bin/python -m positronic.vendors.abc_dit.server multitask_200k_yambox_wide_top_rtc \
   --model.abc_python=/opt/abc/.venv/bin/python --model.checkpoint=\"$ABC_DIT_CHECKPOINT\" \"$@\"", "--"]

LABEL org.opencontainers.image.title="abc-dit" \
    org.opencontainers.image.description="ABC-DiT multi-task DiT-XL (abc_dit_xl_200k_model.pt) with ABC's policy server, served over positronic's session protocol. Built with DINOv3: see /opt/abc_dit/NOTICE." \
    org.opencontainers.image.licenses="Apache-2.0 AND LicenseRef-DINOv3" \
    org.opencontainers.image.source="https://github.com/Positronic-Robotics/positronic"
