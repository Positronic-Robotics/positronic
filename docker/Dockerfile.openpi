ARG BASE_IMAGE=positro/openpi-base:latest
FROM ${BASE_IMAGE}

# The base holds ca-certificates 20230311 and openpi's lock pins certifi 2025.4.26. Both trust the leaked eMudhra
# (emSign) intermediate CAs.
RUN apt-get update && apt-get install -y --no-install-recommends --only-upgrade ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && uv pip install --no-config --python /.venv/bin/python certifi==2026.10.23
# `uv run --project /openpi` makes /openpi/.venv at start from openpi's lock, so its clients read the upgraded store.
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    AWS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    GRPC_DEFAULT_SSL_ROOTS_FILE_PATH=/etc/ssl/certs/ca-certificates.crt

# Set working directory
WORKDIR /positronic

# Copy the positronic repository
COPY . /positronic


# Update Python path to include both projects
ENV PYTHONPATH=/positronic:/openpi

# Default command
CMD ["bash"]
